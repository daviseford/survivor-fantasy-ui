# Intentionally committed: inert demo-project configuration for the isolated
# auth-flow e2e suite (yarn e2e:auth-flows). Loaded by Vite only with
# `--mode e2e-auth`. The `demo-auth-flows` project id cannot address production
# Firebase resources; combined with the emulator wiring in src/firebase.ts and
# the demo- project guard there, this configuration only ever talks to local
# Firebase emulators. There is deliberately no measurement id.
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo-auth-flows.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-auth-flows
VITE_FIREBASE_STORAGE_BUCKET=demo-auth-flows.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_DATABASE_URL=https://demo-auth-flows-default-rtdb.firebaseio.com
