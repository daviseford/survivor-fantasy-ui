{
  "compilerOptions": {
    "target": "ES2020",
    // Scripts run through tsx and their tests through vitest, both of which
    // resolve extensionless relative imports. Node16 resolution would demand
    // explicit .js extensions that neither runtime needs, and would also
    // reject the extensionless imports in the shared src/data season files.
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["./**/*.ts"],
  "exclude": ["node_modules"]
}
